APP_NAME=SIGPI

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sigpi
DATABASE_USER=
DATABASE_PASSWORD=

CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
SLA_WARNING_THRESHOLD=0.80

# Clave secreta para firmar los tokens de sesión (S3-03). Genera una propia con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Nivel del registro de eventos (S3-01): DEBUG, INFO, WARNING o ERROR
LOG_LEVEL=INFO