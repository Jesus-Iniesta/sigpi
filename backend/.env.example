APP_NAME=SIGPI

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sigpi
DATABASE_USER=
DATABASE_PASSWORD=

CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
SLA_WARNING_THRESHOLD=0.80

# Clave secreta para firmar los tokens de sesión (S3-03). Genera una propia con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Nivel del registro de eventos (S3-01): DEBUG, INFO, WARNING o ERROR
LOG_LEVEL=INFO
# Proxies de confianza (S5-08): IPs o redes CIDR separadas por comas, por ejemplo
# TRUSTED_PROXIES=10.0.0.5,172.16.0.0/12. La IP auditada se toma de X-Forwarded-For
# solo si la conexión directa viene de uno de ellos. Vacío: siempre la IP directa.
TRUSTED_PROXIES=
